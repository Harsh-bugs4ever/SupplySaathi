# ─────────────────────────────────────────────────────────────────────────────
# SupplySaathi — environment configuration
# Copy to `.env.local` and fill in. NEVER commit real values.
# Nothing here is exposed to the browser: every key is read server-side only.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
DATABASE_PATH=./data/supplysaathi.db
# "demo"  -> deterministic fixtures, no network, no outreach (safe to show)
# "live"  -> real providers; missing integrations produce honest errors
APP_MODE=demo
APP_TIMEZONE=Asia/Kolkata
APP_BASE_URL=http://localhost:3000

# Shared secret the worker uses to call back into the web app (and, if you
# deploy publicly, the password gate in front of the UI). Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
APP_AUTH_ENABLED=false
APP_AUTH_PASSWORD=

# ── DeepSeek (ReasoningProvider) ─────────────────────────────────────────────
# Docs: https://api-docs.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Current models: deepseek-flash (fast/cheap) | deepseek-v4-pro (stronger)
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_MS=60000

# ── Web research provider order ──────────────────────────────────────────────
# Comma-separated. The first provider reporting the needed capability wins; a
# failure falls through to the next. Anakin is the only provider today, but the
# seam is kept so adding one touches nothing outside lib/providers/web.
WEB_PROVIDER_ORDER=anakin

# ── Anakin (WebResearchProvider — primary) ───────────────────────────────────
# Docs: https://anakin.io/docs/api-reference
#   scrape : POST https://api.anakin.io/v1/url-scraper/scrape   (works KEYLESS)
#   search : POST https://api.anakin.io/v1/search               (key required)
# Leave the key blank and page retrieval still works; only search degrades to
# the curated supplier catalogue.
ANAKIN_API_KEY=
ANAKIN_BASE_URL=https://api.anakin.io/v1
ANAKIN_COUNTRY=in
# Headless Chrome for JS-heavy supplier sites. Slower; used only on retry.
ANAKIN_USE_BROWSER_ON_RETRY=true
ANAKIN_TIMEOUT_MS=95000


# ── Cognee (MemoryProvider) ──────────────────────────────────────────────────
# Docs: https://docs.cognee.ai  — Cloud base URL looks like https://<tenant>.aws.cognee.ai
COGNEE_API_KEY=
COGNEE_BASE_URL=
COGNEE_DATASET=supplysaathi
COGNEE_TIMEOUT_MS=45000

# ── Email (EmailProvider) ────────────────────────────────────────────────────
# provider: "none" (export .eml only) | "smtp" | "resend"
#           | "test" (records locally and sends NOTHING — for demos and tests)
EMAIL_PROVIDER=none
EMAIL_FROM_NAME=SupplySaathi
EMAIL_FROM_ADDRESS=
EMAIL_REPLY_TO=
# Demo safety rail: comma-separated addresses. When set, sends to any other
# recipient are refused and the UI shows a persistent "restricted" badge.
EMAIL_ALLOWLIST=

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Resend (https://resend.com/docs/api-reference/emails/send-email)
RESEND_API_KEY=

# ── Agent budget ─────────────────────────────────────────────────────────────
AGENT_MAX_PAGES=12
AGENT_MAX_ROUNDS=2
AGENT_TIME_BUDGET_MS=240000
AGENT_MAX_PAGE_BYTES=800000
