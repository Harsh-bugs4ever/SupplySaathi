{
  "name": "supplysaathi",
  "version": "1.0.0",
  "private": true,
  "description": "SupplySaathi - AI sourcing agent that helps small businesses recover from supplier stockouts.",
  "scripts": {
    "dev": "concurrently -n web,worker -c green,cyan \"next dev -p 3000\" \"npm run worker\"",
    "dev:web": "next dev -p 3000",
    "worker": "tsx watch worker/index.ts",
    "worker:once": "tsx worker/index.ts",
    "build": "next build",
    "start": "concurrently -n web,worker -c green,cyan \"next start -p 3000\" \"tsx worker/index.ts\"",
    "migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "doctor": "tsx scripts/doctor.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "15.1.6",
    "nodemailer": "^6.9.16",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "server-only": "^0.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
